
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum Role {
  ADMIN
  USER
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  blogs         Blog[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique  // stored as SHA-256 hash of the raw token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  location    String
  date        DateTime
  time        String?  // e.g. "10:00 AM – 1:00 PM"
  tag         String?  // e.g. "Featured", "Youth", "Prayer", "Community"
  color       String?  // e.g. "#0096FF"
  featured    Boolean  @default(false)
  images      Json?    // Array of image URLs for past events
  type        String   @default("UPCOMING") // "UPCOMING", "PAST", "HOME_FELLOWSHIP"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rsvps       EventRsvp[]
}

model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName  String
  email     String
  phone     String?
  guests    Int      @default(1)
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([eventId, email])
}

model Photo {
  id        String   @id @default(uuid())
  url       String   // Cloudinary secure URL
  publicId  String   @unique // Cloudinary public_id — needed for deletion
  title     String
  alt       String
  category  String   @default("General")
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id                   String     @id @default(uuid())

  // Core content
  title                String
  slug                 String     @unique
  excerpt              String     @db.Text
  content              String     @db.LongText
  coverImage           String?
  coverImageAlt        String?
  coverImagePublicId   String?

  // Authorship
  authorId             String
  author               User       @relation(fields: [authorId], references: [id])

  // Classification
  category             String     @default("General")
  tags                 Json       @default("[]")

  // Status & scheduling
  status               BlogStatus @default(DRAFT)
  publishedAt          DateTime?
  scheduledAt          DateTime?
  featured             Boolean    @default(false)

  // Engagement
  viewCount            Int        @default(0)
  readingTime          Int        @default(0)

  // Rank Math-compatible SEO fields
  seoTitle             String?
  seoDescription       String?    @db.Text
  focusKeyword         String?
  additionalKeywords   Json       @default("[]")
  canonicalUrl         String?

  // Open Graph
  ogTitle              String?
  ogDescription        String?    @db.Text
  ogImage              String?

  // Twitter Card
  twitterCard          String     @default("summary_large_image")
  twitterTitle         String?
  twitterDescription   String?    @db.Text

  // Robots directives
  noIndex              Boolean    @default(false)
  noFollow             Boolean    @default(false)

  // JSON-LD structured data
  structuredData       Json?

  // Computed scores (recalculated on save)
  seoScore             Int?
  readabilityScore     Int?

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Leadership {
  id            String       @id @default(uuid())
  name          String
  role          String
  image         String       // Cloudinary URL
  imagePublicId String       @unique
  order         Int          @default(0)
  departments   Department[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Department {
  id              String     @id @default(uuid())
  name            String
  description     String     @db.Text
  backgroundImage String?    // Cloudinary URL for ministry card background
  bgImagePublicId String?    @unique
  leaderId        String
  leader          Leadership @relation(fields: [leaderId], references: [id])
  order           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

